@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <li><h6 class="dropdown-header">Hola, @User.Identity?.Name</h6></li>
    <li><button id="theme-toggle" type="button" class="dropdown-item">Modo oscuro</button></li>
    <li><hr class="dropdown-divider" /></li>
    <li>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="dropdown-item">Salir</button>
        </form>
    </li>
}
else
{
    <li><button id="theme-toggle" type="button" class="dropdown-item">Modo oscuro</button></li>
    <li><hr class="dropdown-divider" /></li>
    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register">Crear cuenta</a></li>
    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a></li>
}
