@using Pedidos360.Services
@inject ICarritoService CarritoService
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Outlet Surf&Skate</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Pedidos360.styles.css" asp-append-version="true" />
    <script>
        // se aplica el tema guardado antes de pintar la página, para que no haya parpadeo.
        // data-bs-theme es el atributo propio de Bootstrap: sin este, sus componentes
        // (badges, formularios, etc.) se quedan con el texto oscuro de siempre aunque
        // el fondo de la página ya esté oscuro.
        (function () {
            var guardado = localStorage.getItem("tema");
            var tema = guardado || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            document.documentElement.setAttribute("data-theme", tema);
            document.documentElement.setAttribute("data-bs-theme", tema);
        })();
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm mb-3">
            <div class="container-fluid navbar-fila">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Outlet Surf&amp;Skate</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-herramientas">
                    @if (User.IsInRole("Cliente"))
                    {
                        <a class="carrito-rapido" asp-area="" asp-controller="Carrito" asp-action="Index" aria-label="Carrito" title="Carrito">
                            <svg class="icono-carrito" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                            @{ var cantidadCarrito = CarritoService.ObtenerItems().Sum(i => i.Cantidad); }
                            @if (cantidadCarrito > 0)
                            {
                                <span class="carrito-badge">@cantidadCarrito</span>
                            }
                        </a>
                    }
                    <div class="dropdown menu-cuenta">
                        <button class="btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @(User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : "Cuenta")
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <partial name="_LoginPartial" />
                        </ul>
                    </div>
                </div>

                <div class="navbar-collapse collapse d-sm-inline-flex">
                    <ul class="navbar-nav navbar-enlaces">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Pedidos" asp-action="Index">Pedidos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Clientes" asp-action="Index">Clientes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Productos" asp-action="Index">Productos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Categorias" asp-action="Index">Categorías</a>
                            </li>
                        }
                        else if (User.IsInRole("Cliente"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Tienda" asp-action="Index">Tienda</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Pedidos" asp-action="Index">Mis pedidos</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Pedidos360 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
