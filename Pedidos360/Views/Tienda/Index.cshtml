@model IEnumerable<Pedidos360.Models.Producto>

@{
    ViewData["Title"] = "Tienda";
}

<h1>Tienda</h1>

@if (TempData["ErrorCarrito"] != null)
{
    <p class="text-danger">@TempData["ErrorCarrito"]</p>
}

<div class="buscador-tienda">
    <input type="text" id="buscador-tienda" class="form-control" placeholder="Buscar por nombre..." value="@ViewData["Termino"]" autocomplete="off" />
</div>

<div id="grid-productos-contenedor">
    <partial name="_GridProductos" model="Model" />
</div>

@section Scripts {
    <script src="~/js/tienda.js" asp-append-version="true"></script>
}
