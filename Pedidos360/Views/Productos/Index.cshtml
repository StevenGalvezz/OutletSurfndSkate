@model IEnumerable<Pedidos360.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo producto</a>
</p>

<div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead>
        <tr>
            <th>Foto</th>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>Categoría</th>
            <th class="text-end">@Html.DisplayNameFor(model => model.Precio)</th>
            <th class="text-end">@Html.DisplayNameFor(model => model.ImpuestoPorc)</th>
            <th class="text-end">@Html.DisplayNameFor(model => model.Stock)</th>
            <th class="text-center">@Html.DisplayNameFor(model => model.Activo)</th>
            <th class="text-end"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width: 72px;"><partial name="_ImagenProducto" model="(item.ImagenUrl, item.Nombre)" /></td>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td><span class="badge text-bg-secondary">@item.Categoria?.Nombre</span></td>
                <td class="text-end">@item.Precio.ToString("C", System.Globalization.CultureInfo.CurrentCulture)</td>
                <td class="text-end">@item.ImpuestoPorc %</td>
                <td class="text-end">@item.Stock</td>
                <td class="text-center">
                    @if (item.Activo)
                    {
                        <span class="badge text-bg-success">Sí</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">No</span>
                    }
                </td>
                <td class="acciones-fila text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
